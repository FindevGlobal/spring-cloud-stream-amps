<AMPSConfig>
    <Name>Common</Name>
    <Admin>
        <FileName>/base/data/amps/common/stats.db</FileName>
        <InetAddr>50005</InetAddr>
        <SQLTransport>websocket-any</SQLTransport>
    </Admin>
    <Tuning>
        <NUMA>
            <Enabled>disabled</Enabled>
        </NUMA>
    </Tuning>
    <Transports>
        <Transport>
            <Name>json-tcp</Name>
            <Type>tcp</Type>
            <InetAddr>50000</InetAddr>
            <ReuseAddr>true</ReuseAddr>
            <Protocol>amps</Protocol>
            <MessageType>json</MessageType>
        </Transport>
        <Transport>
            <Name>json-websocket</Name>
            <Type>tcp</Type>
            <Protocol>websocket</Protocol>
            <InetAddr>9100</InetAddr>
            <MessageType>json</MessageType>
        </Transport>
        <Transport>
            <Name>websocket-any</Name>
            <Protocol>websocket</Protocol>
            <Type>tcp</Type>
            <InetAddr>50001</InetAddr>
        </Transport>
    </Transports>
    <MiniDumpDirectory>/base/data/amps/common</MiniDumpDirectory>
    <MessageMemoryLimit>10GB</MessageMemoryLimit>
    <MessageDiskPath>/base/apps/amps/data/common/offline</MessageDiskPath>
    <ClientMessageAgeLimit>90s</ClientMessageAgeLimit>
    <Logging>
        <Target>
            <Protocol>file</Protocol>
            <FileName>/base/logs/amps/common/amps-info.%Y%m%dT%H%M%S-%n.log</FileName>
            <RotationThreshold>1G</RotationThreshold>
            <Level>info</Level>
            <ExcludeErrors>02-0003</ExcludeErrors>
        </Target>
        <Target>
            <Protocol>file</Protocol>
            <FileName>/base/logs/amps/common/error/amps-error.%Y%m%dT%H%M%S-%n.log</FileName>
            <RotationThreshold>1G</RotationThreshold>
            <Level>error</Level>
        </Target>
        <Target>
            <Protocol>file</Protocol>
            <FileName>/base/logs/amps/common/heartbeat/amps-heartbeat.%Y%m%dT%H%M%S-%n.log</FileName>
            <RotationThreshold>1G</RotationThreshold>
            <IncludeErrors>12-0009,17-1011,02-0003</IncludeErrors>
        </Target>
        <Target>
            <Protocol>file</Protocol>
            <FileName>/base/logs/amps/common/ninja/amps-ninja.%Y%m%d%H%M%S.log</FileName>
            <RotationThreshold>1G</RotationThreshold>
            <Level>none</Level>
            <IncludeErrors>00-0000,28-0003,28-0004</IncludeErrors>
        </Target>
    </Logging>
    <SOW>
        <!-- TOPIC 1 -->
        <Topic>
            <FileName>/base/apps/amps/data/common/sow/%n.sow</FileName>
            <Name>/topic1</Name>
            <MessageType>json</MessageType>
            <Expiration>7d</Expiration>
            <SlabSize>25mb</SlabSize>
            <Key>/id</Key>
        </Topic>
        <Queue>
            <Name>/topic1/queue</Name>
            <MessageType>json</MessageType>
            <Expiration>7d</Expiration>
            <Semantics>at-least-once</Semantics>
            <LeasePeriod>60s</LeasePeriod>
            <MaxPerSubscriptionBacklog>1</MaxPerSubscriptionBacklog>
            <UnderlyingTopic>/topic1</UnderlyingTopic>
        </Queue>

        <!-- TOPIC 2 -->
        <Topic>
            <FileName>/base/apps/amps/data/common/sow/%n.sow</FileName>
            <Name>/topic2</Name>
            <MessageType>json</MessageType>
            <Expiration>7d</Expiration>
            <SlabSize>100mb</SlabSize>
            <Key>/id</Key>
        </Topic>
        <Queue>
            <Name>/topic2/queue</Name>
            <MessageType>json</MessageType>
            <Expiration>7d</Expiration>
            <Semantics>at-least-once</Semantics>
            <LeasePeriod>60s</LeasePeriod>
            <MaxPerSubscriptionBacklog>1</MaxPerSubscriptionBacklog>
            <UnderlyingTopic>/topic2</UnderlyingTopic>
        </Queue>

        <!-- TOPIC 3 -->
        <Topic>
            <FileName>/base/apps/amps/data/common/sow/%n.sow</FileName>
            <Name>/topic3</Name>
            <MessageType>json</MessageType>
            <Expiration>7d</Expiration>
            <SlabSize>100mb</SlabSize>
            <Key>/id</Key>
        </Topic>
        <Queue>
            <Name>/topic3/queue</Name>
            <MessageType>json</MessageType>
            <Expiration>7d</Expiration>
            <Semantics>at-least-once</Semantics>
            <LeasePeriod>60s</LeasePeriod>
            <MaxPerSubscriptionBacklog>1</MaxPerSubscriptionBacklog>
            <UnderlyingTopic>/topic3</UnderlyingTopic>
        </Queue>

    </SOW>
    <Actions>
    </Actions>
    <TransactionLog>
        <JournalDirectory>/base/data/amps/common/journal</JournalDirectory>
        <PreallocatedJournalFiles>1</PreallocatedJournalFiles>
        <!-- TOPIC 1 -->
        <Topic>
            <Name>/topic1</Name>
            <MessageType>json</MessageType>
        </Topic>
        <Topic>
            <Name>/topic1/queue</Name>
            <MessageType>json</MessageType>
        </Topic>

        <!-- TOPIC 2 -->
        <Topic>
            <Name>/topic2</Name>
            <MessageType>json</MessageType>
        </Topic>
        <Topic>
            <Name>/topic2/queue</Name>
            <MessageType>json</MessageType>
        </Topic>

        <!-- TOPIC 3 -->
        <Topic>
            <Name>/topic3</Name>
            <MessageType>json</MessageType>
        </Topic>
        <Topic>
            <Name>/topic3/queue</Name>
            <MessageType>json</MessageType>
        </Topic>

    </TransactionLog>
    <Group>CA</Group>
    <Replication/>
</AMPSConfig>